{
  "name": "budget-personnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/dev.js",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "owner:create": "node --env-file-if-exists=.env scripts/create-owner.js"
  },
  "dependencies": {
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "@neondatabase/serverless": "^1.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
